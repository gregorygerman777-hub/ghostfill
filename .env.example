# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Solana mainnet RPC. A provider endpoint (Helius, Triton, QuickNode...) is needed
# for the top-holder check: the public endpoint rate-limits getTokenLargestAccounts.
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: websocket endpoint for the slot stream (defaults to RPC_URL with ws/wss).
# WS_URL=

# Optional: config file inside ./config (config.yaml or zscore.yaml)
# GHOSTFILL_CONFIG_FILE=config.yaml
