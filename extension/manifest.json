{
  "manifest_version": 3,
  "name": "Ghostfill",
  "version": "0.2.0",
  "description": "Paper-trading terminal for Solana tokens: badge P&L and live status from your local Ghostfill. Simulation only, never trades real funds.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ghostfill (paper mode)",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "background": {"service_worker": "background.js"},
  "permissions": ["alarms", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
