{
  "manifest_version": 3,
  "name": "solpaper monitor",
  "version": "0.1.0",
  "description": "Read-only view of a local solpaper paper-trading service. Simulation only.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "solpaper (paper only)",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "background": {"service_worker": "background.js"},
  "permissions": ["alarms", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
